#~ msgid ""
#~ "Optional email-address of a mailing list which can optionally be used to "
#~ "send \"global\" announcements to. If set then global @all emails are "
#~ "rather sent by default to this mailing list than sending it to each "
#~ "individual recipient by Bcc: as the latter may have legal implications "
#~ "unless you have obtained permission to do so from each individual "
#~ "musician. Mailing list transport will not be used when restricting the "
#~ "set of musicians by their instrument or member status, or when individual "
#~ "recipients are selected. It can also optionally be disabled in the email-"
#~ "form's address selection tab."
