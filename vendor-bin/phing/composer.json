{
  "platform": {
    "php": "8.4"
  },
  "config": {
    "allow-plugins": {
      "cweagans/composer-patches": true
    }
  },
  "sort-packages": true,
  "require-dev": {
    "cweagans/composer-patches": "^1.7",
    "phing/phing": "^3.1.2"
  },
  "extra": {
    "patches": {
      "phing/phing": {
        "Make it work with junit log of recent PHPUnit releases": "../../dev-scripts/lib/patches/phing/phing/fix-junit-log-dom-parsing.patch",
        "Do not use underscores in file-names, xslt does not like it": "../../dev-scripts/lib/patches/phing/phing/replace-backslash-by-underscore-for-recent-xslt-compatibility.patch",
        "XSLT really does not like backslashes in file-names": "../../dev-scripts/lib/patches/phing/phing/replace-backslash-by-slash-in-package-names.patch",
        "Fix PHP deprectations": "../../dev-scripts/lib/patches/phing/phing/fix-php-deprectations.patch"
      }
    }
  }
}
